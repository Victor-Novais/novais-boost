{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOVAIS boost tweak",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "category",
    "level",
    "evidence",
    "risk",
    "requiresReboot",
    "compat",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "$ref": "#/$defs/nonblank"
    },
    "description": {
      "$ref": "#/$defs/nonblank"
    },
    "category": {
      "$ref": "#/$defs/nonblank"
    },
    "level": {
      "enum": [
        "safe",
        "competitive",
        "extreme"
      ]
    },
    "evidence": {
      "description": "measured: proven in a benchmark; documented: official Microsoft/vendor documentation; experimental: neither (custom list only, never in a level).",
      "enum": [
        "measured",
        "documented",
        "experimental"
      ]
    },
    "risk": {
      "$ref": "#/$defs/nonblank"
    },
    "requiresReboot": {
      "type": "boolean"
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware",
        "antiCheat"
      ],
      "properties": {
        "hardware": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "desktop",
              "gpu-discrete",
              "gpu-hags",
              "gpu-nvidia",
              "not-dual-ccd-x3d"
            ]
          }
        },
        "antiCheat": {
          "description": "Anti-cheats that may refuse the tweak. Shown as a warning at review when a game using one is installed.",
          "type": "array",
          "items": {
            "enum": [
              "Vanguard",
              "FACEIT",
              "Easy Anti-Cheat",
              "BattlEye",
              "Ricochet",
              "VAC"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/registry"
          },
          {
            "$ref": "#/$defs/service"
          },
          {
            "$ref": "#/$defs/powercfg"
          },
          {
            "$ref": "#/$defs/scheduledTask"
          },
          {
            "$ref": "#/$defs/powerPlan"
          },
          {
            "$ref": "#/$defs/nvidiaSetting"
          },
          {
            "$ref": "#/$defs/dns"
          },
          {
            "$ref": "#/$defs/bcd"
          },
          {
            "$ref": "#/$defs/pagefile"
          },
          {
            "$ref": "#/$defs/tcpGlobal"
          },
          {
            "$ref": "#/$defs/configFile"
          },
          {
            "$ref": "#/$defs/nvidiaProfile"
          },
          {
            "$ref": "#/$defs/amdSetting"
          },
          {
            "$ref": "#/$defs/defenderExclusion"
          }
        ]
      }
    }
  },
  "$defs": {
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "registryValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {}
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "string",
                "expandString"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "dword"
            },
            "value": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "qword"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "multiString"
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "binary",
                "none"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "hive",
        "path",
        "valueName",
        "operation",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "registry"
        },
        "hive": {
          "enum": [
            "currentUser",
            "localMachine"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[^\\u0000\\\\]+(\\\\[^\\u0000\\\\]+)+$"
        },
        "valueName": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        },
        "operation": {
          "enum": [
            "set",
            "delete"
          ]
        },
        "expected": {},
        "accept": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/registryValue"
          }
        },
        "acceptRange": {
          "description": "A DWORD/QWORD inside this inclusive range already satisfies the action (DWORDs compared as unsigned).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        },
        "acceptIfBitsClear": {
          "description": "A DWORD with none of these bits set already satisfies the action.",
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "operation": {
            "const": "set"
          }
        }
      },
      "then": {
        "properties": {
          "expected": {
            "$ref": "#/$defs/registryValue"
          }
        }
      },
      "else": {
        "properties": {
          "expected": {
            "type": "null"
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "service"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "expected": {
          "enum": [
            "automatic",
            "automaticDelayed",
            "manual",
            "disabled"
          ]
        },
        "accept": {
          "description": "Startup types that already satisfy the action (repairs only fix a disabled service).",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "automatic",
              "automaticDelayed",
              "manual",
              "disabled"
            ]
          }
        }
      }
    },
    "powercfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "powercfg"
        },
        "expected": {
          "$ref": "#/$defs/guid"
        }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
    },
    "scheduledTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "scheduledTask"
        },
        "path": {
          "type": "string",
          "pattern": "^\\\\[^\u0000\"]+$"
        },
        "expected": {
          "enum": [
            "enabled",
            "disabled"
          ]
        }
      }
    },
    "powerPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "template",
        "settings"
      ],
      "properties": {
        "type": {
          "const": "powerPlan"
        },
        "id": {
          "$ref": "#/$defs/guid"
        },
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "template": {
          "$ref": "#/$defs/guid"
        },
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subgroup",
              "setting",
              "ac",
              "dc"
            ],
            "properties": {
              "subgroup": {
                "$ref": "#/$defs/guid"
              },
              "setting": {
                "$ref": "#/$defs/guid"
              },
              "ac": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "dc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        }
      }
    },
    "nvidiaSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "settingId",
        "name",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "nvidiaSetting"
        },
        "settingId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "expected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "interfaceId",
        "alias",
        "servers"
      ],
      "properties": {
        "type": {
          "const": "dns"
        },
        "interfaceId": {
          "$ref": "#/$defs/guid"
        },
        "alias": {
          "$ref": "#/$defs/nonblank"
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{1,3}(\\.\\d{1,3}){3}$"
          }
        }
      }
    },
    "bcd": {
      "description": "Element of the {current} boot entry (bcdedit). expected null removes the element (Windows default).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "element",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "bcd"
        },
        "element": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{2,40}$"
        },
        "expected": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,20}$"
            }
          ]
        }
      }
    },
    "pagefile": {
      "description": "Paging file. systemManaged true = managed by the system; an existing manual paging file is left alone.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "systemManaged"
      ],
      "properties": {
        "type": {
          "const": "pagefile"
        },
        "systemManaged": {
          "type": "boolean"
        }
      }
    },
    "tcpGlobal": {
      "description": "Global TCP setting (netsh int tcp set global).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "setting",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "tcpGlobal"
        },
        "setting": {
          "enum": [
            "autotuninglevel",
            "rss"
          ]
        },
        "expected": {
          "enum": [
            "disabled",
            "highlyrestricted",
            "restricted",
            "normal",
            "experimental",
            "enabled"
          ]
        }
      }
    },
    "configFile": {
      "description": "One key of a game configuration file. The file and the key must already exist; never written while the game runs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path",
        "format",
        "section",
        "key",
        "value",
        "lockedBy"
      ],
      "properties": {
        "type": {
          "const": "configFile"
        },
        "path": {
          "$ref": "#/$defs/nonblank"
        },
        "format": {
          "enum": [
            "ini",
            "keyValue",
            "cfg",
            "json"
          ]
        },
        "section": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonblank"
            }
          ]
        },
        "key": {
          "type": "string",
          "pattern": "^[^\\r\\n=\\[\\]\"]+$"
        },
        "value": {
          "type": "string",
          "pattern": "^[^\\r\\n\"]*$"
        },
        "lockedBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        }
      }
    },
    "nvidiaProfile": {
      "description": "DWORD setting in the NVIDIA driver profile of one executable (created as \"NOVAIS boost - exe\" when missing).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "exe",
        "settingId",
        "name",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "nvidiaProfile"
        },
        "exe": {
          "type": "string",
          "pattern": "^[^\\\\/:*?\"<>|]+\\.exe$"
        },
        "settingId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "expected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "amdSetting": {
      "description": "Radeon Software feature through ADLX.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "feature",
        "enabled"
      ],
      "properties": {
        "type": {
          "const": "amdSetting"
        },
        "feature": {
          "enum": [
            "AntiLag",
            "Chill",
            "Boost",
            "EnhancedSync",
            "HyprRx"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "defenderExclusion": {
      "description": "Microsoft Defender folder exclusion (opt-in, reversible). Only absolute folder paths, never a drive root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "const": "defenderExclusion"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z]:\\\\[^\\u0000*?\"<>|]+$"
        }
      }
    }
  }
}
