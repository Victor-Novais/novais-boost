      "hive": "localMachine",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "valueName": "DisableAIDataAnalysis",
      "operation": "set",
      "expected": {
        "kind": "dword",
        "value": 1
      }
    },
    {
      "type": "registry",
      "hive": "currentUser",
      "path": "Software\\Policies\\Microsoft\\Windows\\WindowsAI",
      "valueName": "DisableAIDataAnalysis",
      "operation": "set",
      "expected": {
        "kind": "dword",
        "value": 1
      }
    }
  ]
}
