{
  "id": "recall-off",
  "name": "Desligar o Recall",
  "description": "Impede o Recall de tirar capturas de tela contínuas, que custam disco, CPU e privacidade.",
  "category": "Privacidade",
  "level": "safe",
  "risk": "Nenhum.",
  "requiresReboot": false,
  "compat": {
    "hardware": [],
    "antiCheat": []
  },
  "actions": [
    {
