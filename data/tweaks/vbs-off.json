{
  "id": "vbs-off",
  "name": "Desligar VBS / Integridade de memória",
  "description": "Desliga a segurança baseada em virtualização (VBS) e a Integridade de memória (HVCI). Ganho típico de 5-10% de FPS em CPUs mais antigas.",
  "category": "Segurança",
  "level": "extreme",
  "risk": "ALTO. O Windows fica mais exposto a malware de kernel. Não afeta Vanguard, FACEIT ou EAC, mas desative só em PC dedicado a jogos.",
  "requiresReboot": true,
  "compat": {
    "hardware": [],
    "antiCheat": []
  },
  "actions": [
    {
      "type": "registry",
      "hive": "localMachine",
      "path": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard",
      "valueName": "EnableVirtualizationBasedSecurity",
      "operation": "set",
      "expected": {
        "kind": "dword",
        "value": 0
      }
    },
    {
      "type": "registry",
      "hive": "localMachine",
      "path": "SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
      "valueName": "Enabled",
      "operation": "set",
      "expected": {
        "kind": "dword",
        "value": 0
      }
    }
  ]
}
