{
  "id": "telemetry-tasks",
  "name": "Desligar tarefas agendadas de telemetria",
  "description": "Desativa tarefas que coletam dados de uso em segundo plano (podem gerar picos de disco e CPU durante o jogo). Tarefas que não existem nesta versão do Windows são ignoradas.",
  "category": "Privacidade",
  "level": "safe",
  "evidence": "documented",
  "risk": "Baixo.",
  "requiresReboot": false,
  "compat": {
    "hardware": [],
    "antiCheat": []
  },
  "actions": [
    {
      "type": "scheduledTask",
      "path": "\\Microsoft\\Windows\\Application Experience\\Microsoft Compatibility Appraiser",
      "expected": "disabled"
    },
    {
      "type": "scheduledTask",
      "path": "\\Microsoft\\Windows\\Application Experience\\ProgramDataUpdater",
      "expected": "disabled"
    },
    {
      "type": "scheduledTask",
      "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\Consolidator",
      "expected": "disabled"
    },
    {
      "type": "scheduledTask",
      "path": "\\Microsoft\\Windows\\Customer Experience Improvement Program\\UsbCeip",
      "expected": "disabled"
    },
    {
      "type": "scheduledTask",
      "path": "\\Microsoft\\Windows\\Autochk\\Proxy",
      "expected": "disabled"
    },
    {
      "type": "scheduledTask",
      "path": "\\Microsoft\\Windows\\DiskDiagnostic\\Microsoft-Windows-DiskDiagnosticDataCollector",
      "expected": "disabled"
    }
  ]
}
