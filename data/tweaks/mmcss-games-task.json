{
  "id": "mmcss-games-task",
  "name": "Agendador multimídia: prioridade da tarefa \"Games\"",
  "description": "Sobe a prioridade de CPU, GPU e disco da tarefa \"Games\" do MMCSS. Só afeta threads que o próprio jogo registra nessa tarefa, e poucos jogos fazem isso.",
  "category": "CPU",
  "level": "competitive",
  "evidence": "experimental",
  "risk": "Baixo.",
  "requiresReboot": true,
  "compat": {
    "hardware": [],
    "antiCheat": []
  },
  "actions": [
    {
      "type": "registry",
      "hive": "localMachine",
      "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
      "valueName": "GPU Priority",
      "operation": "set",
      "expected": {
        "kind": "dword",
        "value": 8
      }
    },
    {
      "type": "registry",
      "hive": "localMachine",
      "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
      "valueName": "Priority",
      "operation": "set",
      "expected": {
        "kind": "dword",
        "value": 6
      }
    },
    {
      "type": "registry",
      "hive": "localMachine",
      "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
      "valueName": "Scheduling Category",
      "operation": "set",
      "expected": {
        "kind": "string",
        "value": "High"
      }
    },
    {
      "type": "registry",
      "hive": "localMachine",
      "path": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile\\Tasks\\Games",
      "valueName": "SFIO Priority",
      "operation": "set",
      "expected": {
        "kind": "string",
        "value": "High"
      }
    }
  ]
}
