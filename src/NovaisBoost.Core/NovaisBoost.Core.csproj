<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <EmbeddedResource Include="../../data/tweaks/*.json" LogicalName="Tweaks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/*.json" LogicalName="Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
