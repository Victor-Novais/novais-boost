<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <EmbeddedResource Include="../../data/tweaks/*.json" LogicalName="Tweaks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/repairs/*.json" LogicalName="Repairs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/games/*.json" LogicalName="Presets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/*.json" LogicalName="Data.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/bloat/*.json" LogicalName="Bloat.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/i18n/*.json" LogicalName="I18n.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
