<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.0.0</Version>
    <Product>NOVAIS boost</Product>
    <AssemblyName>NovaisBoost.App</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Real-time kernel sessions only use advapi32; the native helpers (KernelTraceControl, msdia) are for merging
         .etl files and symbols, which we do not use, so they are left out of the single exe. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.9" />
    <ProjectReference Include="../NovaisBoost.Core/NovaisBoost.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="System.Management" Version="10.0.9" />
  </ItemGroup>
</Project>
